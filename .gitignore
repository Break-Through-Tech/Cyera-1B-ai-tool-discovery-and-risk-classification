# Environment variables / secrets
.env
.env.*
!.env.example

# Local virtual environments (never commit these)
.venv/
.venv-*/

# Trained model weights / bundles — train locally, do not push
*.joblib
*.safetensors
*.npy

# Downloaded encoders (Hugging Face / sentence-transformers caches)
**/encoder/

# Derived embedding caches and local category training run outputs
/artifacts/embedding_cache/
/data/cache/category_embeddings/
/models/categories/
/models/ai_detection/embeddings/
/models/category_embeddings/
/models/category_embeddings_tuned/
/models/category/

**/__pycache__/

# Local report search indexes (snapshots and derived vectors)
/data/cache/governance_retrieval/
*.faiss

# Provider response cache; share reviewed run outputs instead.
/data/cache/jev_classification.json

/data/cache/jev_catalog/
